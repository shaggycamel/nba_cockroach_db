# Template for credentials.ini -- copy, fill in, and keep it OUT of git.
#
#   cp credentials.ini.example credentials.ini      # local dev, read from the repo root
#
# On the cron host the real file lives outside the repo and is the only thing the
# container is given:
#
#   mkdir -p ~/.config/nba_cockroach_db && chmod 700 ~/.config/nba_cockroach_db
#   cp credentials.ini.example ~/.config/nba_cockroach_db/credentials.ini
#   chmod 600 ~/.config/nba_cockroach_db/credentials.ini
#
# cron.sh bind-mounts it read-only at /app/credentials.ini. Nothing here is ever
# baked into the image (.dockerignore excludes it).

# --- databases: one section per platform, selected by [runtime] db_con ---------
# sports-hub builds the SQLAlchemy URL from these six keys. Do not add other keys
# to these sections: the URL is assembled by substituting each key name into the
# template 'dialect://user:password@host:port/database'.

[postgres]
dialect = postgresql
user = postgres
password = CHANGEME
host = localhost
port = 5432
database = nba

[cockroach]
dialect = cockroachdb
user = CHANGEME
password = CHANGEME
host = CHANGEME.gcp-europe-west1.cockroachlabs.cloud
port = 26257
database = nba

# --- which database this run writes to ----------------------------------------
# Override with the DB_CON environment variable, which wins when set.

[runtime]
db_con = postgres

# --- failure alerts (optional) ------------------------------------------------
# Without user + password the failure email is skipped and the run just exits 1.
# Overrides: SMTP_USER, SMTP_PASSWORD, ALERT_TO.

[smtp]
user =
password =
to =

# --- third-party data sources -------------------------------------------------
# Statyx API key. Override with STATYX_API_KEY.

[statyx]
key = CHANGEME

# Fantasy platform sections. By design these are placeholder templates: at connect
# time sports-hub replaces every {key} with the matching value from that league's
# fty.customer_platform.credentials row (plus league_id / cur_year). See
# sports_hub/fty.py::_connect_leagues.
#
# Substitution is plain string replacement, so any key left as a literal value is
# passed through unchanged -- which is how a real secret can end up living here
# instead of in the database. Prefer the placeholders below and keep the real values
# in fty.customer_platform; only hard-code a key here if that row lacks it.

[espn_api]
league_id = {league_id}
year = {year}
espn_s2 = {espn_s2}
swid = {swid}

[yahoo_api]
league_id = {league_id}
access_token = {access_token}
consumer_key = {consumer_key}
consumer_secret = {consumer_secret}
guid = {guid}
refresh_token = {refresh_token}
token_time = {token_time}
token_type = {token_type}
